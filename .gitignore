# Downloaded and derived data is never committed. Every dataset here is licensed
# separately and more restrictively than this repository, see THIRD_PARTY_NOTICES.md,
# and the DALES-2 labels carry a non-commercial restriction upstream.
data/*
!data/artifacts/
data/artifacts/*.tmp

# Artefacts ARE committed: they are the evidence for every number in the README,
# and several of them cost hours of GPU time to reproduce.
!data/artifacts/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.log
# The GPU chain logs are the record of when each rule was written against when each run
# finished, so they are committed.
!data/artifacts/logs/*.log

# The viewer's dependencies and build output are regenerated by npm.
node_modules/
web/dist/
web/dist-prototype/
web/dist-investigate/

# Local editor and tool settings, and the working log, not part of the project.
.claude/
progress.md
