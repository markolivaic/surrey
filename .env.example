# Every variable the code reads. The two tool paths are optional: without them the tools are looked for
# on PATH and in the usual install folders, and the code says where it looked if it cannot find one.

# Full path to ffmpeg, used only to encode the walkthrough recording.
SURREY_FFMPEG=

# Full path to PotreeConverter 2.1.3, used only to build the page's octrees from predictions.
SURREY_POTREECONVERTER=

# The private key for the rented GPU box, used by scripts/pipeline/rented_push.sh and rented_pull.sh.
# Optional; without it they use ~/.ssh/vast_surrey.
SURREY_SSH_KEY=

# The Hugging Face dataset a rented round uploads its outputs to, read on the rented box by
# scripts/pipeline/phase6_chain.sh, for example markolivaic/surrey-phase6. Required there, unused
# anywhere else. The login that allows the upload is made on the box with `hf auth login`, never here.
HF_REPO=
