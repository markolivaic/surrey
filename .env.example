# Every variable the code reads. Both are optional: without them the tools are looked for on PATH and
# in the usual install folders, and the code says where it looked if it cannot find one.

# Full path to ffmpeg, used only to encode the walkthrough recording.
SURREY_FFMPEG=

# Full path to PotreeConverter 2.1.3, used only to build the page's octrees from predictions.
SURREY_POTREECONVERTER=
