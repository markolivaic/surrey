    "1": {
      "name": "unclassified and temporary objects",
      "m1_label": -1,
      "reason": "mixes vehicles, cranes and anything unresolved; DALES splits vehicles four ways and has no class for the rest"
    },
    "2": {
      "name": "ground",
      "m1_label": 0,
      "reason": "the same class"
    },
    "3": {
      "name": "vegetation (low - medium - high)",
      "m1_label": -1,
      "reason": "flown in February and March with no leaves; bare branches could undo the vegetation San Francisco just got back, so M1 learns vegetation from DALES alone"
    },
    "6": {
      "name": "building roofs",
      "m1_label": 100,
      "reason": "one Swiss building class against three DALES ones; scored as the building superclass"
    },
    "9": {
      "name": "water",
      "m1_label": 15,
      "reason": "the class M1 exists to add"
    },
    "14": {
      "name": "high-voltage / power line",
      "m1_label": 3,
      "reason": "a conductor span, the object DALES labels powerline"
    },
    "15": {
      "name": "masts with a load-bearing function",
      "m1_label": -1,
      "reason": "lattice pylons and masts; DALES poles are utility, light and traffic poles, a different object, and no class fits"
    },
    "17": {
      "name": "bridge-, overpass-, viaduct- and footbridge deck",
      "m1_label": 16,
      "reason": "the class M1 exists to add, and the only bridge part the San Francisco delivery labels"
    },
    "26": {
      "name": "building facades",
      "m1_label": 100,
      "reason": "part of the building, as DALES labels walls"
    },
    "27": {
      "name": "bridge piers and viaduct stay cables",
      "m1_label": -1,
      "reason": "the San Francisco reference labels decks only, piers are not deck, and stay cables look like powerline; teaching either as deck or wire would be wrong"
    }
  },
